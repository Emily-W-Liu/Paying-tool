FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# Use FEISHU_BITABLE_APP_TOKEN for normal /base/... links.
# Use FEISHU_WIKI_NODE_TOKEN for /wiki/... links. Set one of the two.
FEISHU_BITABLE_APP_TOKEN=bascnxxx
FEISHU_WIKI_NODE_TOKEN=KG1RwbXlvisykokqfGacKL5Ensc

FEISHU_BITABLE_TABLE_ID=tblxxx

# Required before public deployment. Local development falls back to admin123.
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-random-session-secret

# Optional: enables production-safe database and object storage.
# Without these, the app falls back to local JSON files and public/uploads.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=payment-screenshots

# Optional: production URL used for payment screenshot links written to Feishu.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: override these only when your Bitable field names differ.
FEISHU_FIELD_ORDER_ID=订单号
FEISHU_FIELD_CREATED_AT=提交时间
FEISHU_FIELD_CUSTOMER_NAME=用户姓名
FEISHU_FIELD_CONTACT=联系方式
FEISHU_FIELD_ITEMS=商品明细
FEISHU_FIELD_TOTAL=总金额
FEISHU_FIELD_SCREENSHOT=付款截图
FEISHU_FIELD_STATUS=订单状态
FEISHU_FIELD_NOTE=备注
